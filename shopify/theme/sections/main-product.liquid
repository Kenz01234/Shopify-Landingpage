{%- liquid
  assign form_id = 'qa-product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign selected_plan = product.selected_selling_plan
  if has_plans and selected_plan == nil and product.requires_selling_plan
    assign selected_plan = product.selling_plan_groups.first.selling_plans.first
  endif
  if has_plans and selected_plan == nil and section.settings.default_subscription
    assign selected_plan = product.selling_plan_groups.first.selling_plans.first
  endif
  assign shown_price = current_variant.price
  assign compare_price = current_variant.compare_at_price
  if selected_plan
    for a in current_variant.selling_plan_allocations
      if a.selling_plan.id == selected_plan.id
        assign shown_price = a.price
        assign compare_price = a.compare_at_price
      endif
    endfor
  endif
-%}

<div class="qa-container qa-product" data-qa-product data-section-id="{{ section.id }}" data-form-id="{{ form_id }}">
  <div class="qa-gallery" data-reveal>
    {%- if product.media.size > 0 -%}
      {%- assign featured = current_variant.featured_media | default: product.featured_media -%}
      <div class="qa-gallery__main" data-gallery-main>
        {%- if featured.media_type == 'image' -%}
          {{ featured | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: featured.alt | default: product.title }}
        {%- else -%}
          {{ featured | media_tag: image_size: '1400x' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="qa-gallery__thumbs" role="list">
          {%- for m in product.media -%}
            <button type="button" role="listitem" data-media-src="{{ m.preview_image | image_url: width: 1400 }}" data-media-id="{{ m.id }}" aria-label="{{ 'products.show_media' | t: n: forloop.index }}"{% if m.id == featured.id %} aria-current="true"{% endif %}>
              {{ m.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="qa-plan-hero">
        <div class="qa-plan-hero__visual">
          <svg viewBox="0 0 200 200" width="70%" aria-hidden="true">
            <circle cx="100" cy="100" r="78" fill="none" stroke="var(--line)" stroke-width="2" stroke-dasharray="3 8"/>
            <path d="M126 150A62 62 0 1 1 153 117" fill="none" stroke="var(--coral)" stroke-width="16" stroke-linecap="round"/>
            <path d="M141 137c12 11 18 24 36 28" fill="none" stroke="var(--coral)" stroke-width="16" stroke-linecap="round"/>
            <path d="M82 70c0-5 6-9 11-6l34 21c4 3 4 9 0 12l-34 21c-5 3-11-1-11-6z" fill="var(--ink)"/>
          </svg>
        </div>
        <div class="qa-chips">
          <span class="qa-chip">{% render 'platform-icon', platform: 'youtube' %}</span>
          <span class="qa-chip">{% render 'platform-icon', platform: 'instagram' %}</span>
          <span class="qa-chip">{% render 'platform-icon', platform: 'tiktok' %}</span>
          <span class="qa-chip">{{ 'products.approval_included' | t }}</span>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="qa-product__info">
    <nav class="qa-breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
      {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title | escape }}</a><span aria-hidden="true">/</span>{%- endif -%}
      <span>{{ product.title | escape }}</span>
    </nav>
    <div>
      {%- if has_plans -%}<span class="qa-pill qa-pill--coral" style="margin-bottom: 14px">{{ 'products.subscription' | t }}</span>{%- endif -%}
      <h1 class="qa-h2">{{ product.title | escape }}</h1>
    </div>

    <div class="qa-price" data-price>
      <span class="qa-price__now" data-price-now>{{ shown_price | money }}</span>
      <span class="qa-price__was" data-price-was>{% if compare_price > shown_price %}{{ compare_price | money }}{% endif %}</span>
      <span class="qa-price__unit" data-price-unit>{% if selected_plan %}{{ selected_plan.name | escape }}{% endif %}</span>
    </div>
    {%- if cart.taxes_included or shop.taxes_included -%}
      <p class="qa-note">{{ 'products.taxes_included' | t }}</p>
    {%- endif -%}

    {%- form 'product', product, id: form_id, class: 'qa-buy', data-product-form: '', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="qa-variants">
            <legend>{{ option.name | escape }}</legend>
            <div class="qa-swatches">
              {%- for value in option.values -%}
                <label class="qa-swatch">
                  <input type="radio" name="{{ section.id }}-{{ option.position }}" value="{{ value | escape }}" data-option-index="{{ option.position | minus: 1 }}"{% if option.selected_value == value %} checked{% endif %}>
                  <span>{{ value | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- if has_plans -%}
        <fieldset class="qa-variants" data-plans>
          <legend>{{ 'products.purchase_options' | t }}</legend>
          {%- unless product.requires_selling_plan -%}
            <label class="qa-option">
              <input type="radio" name="selling_plan" value=""{% if selected_plan == nil %} checked{% endif %} data-plan-option>
              <span class="qa-option__radio"></span>
              <span class="qa-option__body"><span class="qa-option__title">{{ 'products.one_time' | t }}</span></span>
              <span class="qa-option__price" data-plan-price="">{{ current_variant.price | money }}</span>
            </label>
          {%- endunless -%}
          {%- for group in product.selling_plan_groups -%}
            {%- for plan in group.selling_plans -%}
              {%- assign plan_price = current_variant.price -%}
              {%- for a in current_variant.selling_plan_allocations -%}
                {%- if a.selling_plan.id == plan.id -%}{%- assign plan_price = a.price -%}{%- endif -%}
              {%- endfor -%}
              <label class="qa-option">
                <input type="radio" name="selling_plan" value="{{ plan.id }}"{% if selected_plan.id == plan.id %} checked{% endif %} data-plan-option>
                <span class="qa-option__radio"></span>
                <span class="qa-option__body">
                  <span class="qa-option__title">{{ plan.name | escape }}</span>
                  {%- if plan.description != blank -%}<span class="qa-option__meta">{{ plan.description | escape }}</span>{%- endif -%}
                  {%- if group.name != blank and product.selling_plan_groups.size > 1 -%}<span class="qa-option__meta">{{ group.name | escape }}</span>{%- endif -%}
                </span>
                <span class="qa-option__price" data-plan-price="{{ plan.id }}">{{ plan_price | money }}</span>
              </label>
            {%- endfor -%}
          {%- endfor -%}
        </fieldset>
      {%- endif -%}

      {%- unless has_plans -%}
        <div class="qa-field">
          <span class="qa-label" id="{{ form_id }}-qty">{{ 'products.quantity' | t }}</span>
          <div class="qa-qty" role="group" aria-labelledby="{{ form_id }}-qty">
            <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">−</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-qty-input aria-labelledby="{{ form_id }}-qty">
            <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">+</button>
          </div>
        </div>
      {%- else -%}
        <input type="hidden" name="quantity" value="1">
      {%- endunless -%}

      <div class="qa-buy__row">
        <button class="qa-btn qa-btn--primary qa-btn--lg" type="submit" name="add" data-add{% unless current_variant.available %} disabled{% endunless %}>
          <span class="qa-spinner" aria-hidden="true"></span>
          <span data-add-label data-available="{{ 'products.add_to_cart' | t | escape }}" data-soldout="{{ 'products.sold_out' | t | escape }}">{% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
        </button>
      </div>
      {%- if section.settings.show_direct_checkout -%}
        <button class="qa-btn qa-btn--dark qa-btn--lg qa-btn--block" type="submit" name="return_to" value="/checkout" data-direct-checkout{% unless current_variant.available %} disabled{% endunless %}>
          {{- 'products.buy_now' | t }} {% render 'icon', name: 'arrow-right', class: 'qa-btn__arrow' %}
        </button>
      {%- endif -%}
      {%- if section.settings.show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}
      <p class="qa-note" role="status" data-form-error hidden></p>
    {%- endform -%}

    {%- if settings.after_purchase_note != blank and has_plans -%}
      <div class="qa-card" style="padding: 16px 18px">
        <div class="qa-note" style="color: var(--ink-2)">{{ settings.after_purchase_note }}</div>
      </div>
    {%- endif -%}

    <div class="qa-accordion">
      {%- if product.description != blank -%}
        <details{% if section.settings.description_open %} open{% endif %}>
          <summary>{{ 'products.description' | t }}<span class="qa-plus" aria-hidden="true"></span></summary>
          <div class="qa-accordion__body qa-rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.heading | escape }}<span class="qa-plus" aria-hidden="true"></span></summary>
          <div class="qa-accordion__body qa-rte">{{ block.settings.content }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

<script type="application/json" data-product-json>{{ product | json }}</script>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Produkt",
  "settings": [
    { "type": "checkbox", "id": "default_subscription", "label": "Abo-Option vorauswählen", "default": true },
    { "type": "checkbox", "id": "show_direct_checkout", "label": "Button „Direkt zur Kasse“ zeigen", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Express-Zahlungsbuttons (z. B. Shop Pay) zeigen", "default": false },
    { "type": "checkbox", "id": "description_open", "label": "Beschreibung aufgeklappt", "default": true }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Aufklappbarer Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Was ist enthalten?" },
        { "type": "richtext", "id": "content", "label": "Inhalt", "default": "<p>Recherche, Skript, KI-Stimme, Schnitt, Shorts, automatische Prüfung und Veröffentlichung auf YouTube, Instagram und TikTok – jeweils nach deiner Freigabe.</p>" }
      ]
    }
  ]
}
{% endschema %}
