<section class="qa-section{% if section.settings.tint %} qa-section--tint{% endif %}">
  <div class="qa-container qa-container--narrow" style="text-align: {{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<p class="qa-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="qa-h2" data-split style="margin-top: 14px">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="qa-rte" data-reveal style="margin-top: 20px">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p style="margin-top: 28px"><a class="qa-btn qa-btn--primary qa-btn--lg" href="{% render 'nav-href', link: section.settings.button_link %}">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow-right', class: 'qa-btn__arrow' %}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Oberzeile" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Überschrift" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Erzähle hier mehr über Quest Agent.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text" },
    { "type": "text", "id": "button_link", "label": "Button-Ziel" },
    { "type": "select", "id": "align", "label": "Ausrichtung", "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Mittig" }], "default": "center" },
    { "type": "checkbox", "id": "tint", "label": "Getönter Hintergrund", "default": false }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
