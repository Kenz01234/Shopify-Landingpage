<div class="qa-container qa-page-hero">
  <h1 class="qa-h1" data-split>{{ 'cart.title' | t }}</h1>
</div>
<div class="qa-container" style="padding-bottom: clamp(64px, 10vw, 120px)" data-qa-cart-page data-section-id="{{ section.id }}">
  {%- if cart.item_count == 0 -%}
    <div class="qa-card qa-cart-empty">
      <svg viewBox="0 0 120 80" aria-hidden="true">
        <path d="M6 60 C 30 60, 34 20, 60 20 S 92 64, 114 30" fill="none" stroke="var(--coral)" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 8"/>
        <circle cx="60" cy="20" r="6" fill="var(--coral)"/>
      </svg>
      <p class="qa-h3">{{ 'cart.empty' | t }}</p>
      <p class="qa-muted">{{ 'cart.empty_hint' | t }}</p>
      <a class="qa-btn qa-btn--primary" href="{% render 'nav-href', link: '#preise' %}">{{ 'cart.to_plans' | t }} {% render 'icon', name: 'arrow-right', class: 'qa-btn__arrow' %}</a>
    </div>
  {%- else -%}
    <form class="qa-cart-page" action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
      <div class="qa-card" style="padding: 8px 20px">
        {%- render 'cart-lines' -%}
      </div>
      <div class="qa-card qa-cart-page__summary">
        {%- for d in cart.cart_level_discount_applications -%}
          <div class="qa-subtotal qa-accent" style="font-size: 15px"><span>{{ d.title | escape }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="qa-subtotal"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
        <p class="qa-note">
          {%- if cart.taxes_included -%}{{ 'cart.taxes_included' | t }}{%- else -%}{{ 'cart.taxes_excluded' | t }}{%- endif %}
          {{ 'cart.shipping_at_checkout' | t }}
        </p>
        {%- if section.settings.show_note -%}
          <div class="qa-field">
            <label class="qa-label" for="qa-cart-note">{{ 'cart.note' | t }}</label>
            <textarea class="qa-textarea" id="qa-cart-note" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
        {%- if settings.after_purchase_note != blank -%}
          <div class="qa-note">{{ settings.after_purchase_note }}</div>
        {%- endif -%}
        <button class="qa-btn qa-btn--primary qa-btn--lg qa-btn--block" type="submit" name="checkout">
          {{- 'cart.checkout' | t }} {% render 'icon', name: 'arrow-right', class: 'qa-btn__arrow' %}
        </button>
        <noscript><button class="qa-btn qa-btn--block" type="submit" name="update">{{ 'cart.update' | t }}</button></noscript>
        <a class="qa-btn qa-btn--ghost qa-btn--sm" href="{% render 'nav-href', link: '#preise' %}">{{ 'cart.continue' | t }}</a>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Warenkorb",
  "settings": [{ "type": "checkbox", "id": "show_note", "label": "Anmerkungsfeld zeigen", "default": false }]
}
{% endschema %}
