<div class="qa-container qa-page-hero">
  <h1 class="qa-h1" data-split>{{ blog.title | escape }}</h1>
</div>
<div class="qa-container" style="padding-bottom: clamp(64px, 10vw, 120px)">
  {%- paginate blog.articles by 9 -%}
    <div class="qa-articles">
      {%- for article in blog.articles -%}
        <a class="qa-acard" href="{{ article.url }}" data-reveal style="--rd: {{ forloop.index0 | modulo: 3 | times: 80 }}">
          <div class="qa-acard__img">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', alt: article.image.alt | default: article.title }}{%- endif -%}
          </div>
          <span class="qa-muted" style="font-size: 14px">{{ article.published_at | time_tag: format: 'date' }}</span>
          <span class="qa-h3">{{ article.title | escape }}</span>
          {%- if article.excerpt != blank -%}<span class="qa-muted">{{ article.excerpt | strip_html | truncate: 140 }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
