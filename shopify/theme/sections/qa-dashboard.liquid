{%- liquid
  assign scene_space = 'qa-scene-space.svg' | asset_url
  assign scene_history = 'qa-scene-history.svg' | asset_url
  assign scene_ocean = 'qa-scene-ocean.svg' | asset_url
-%}
<section class="qa-section qa-section--tint" id="{{ section.settings.anchor | default: 'dashboard' }}" data-qa-dash data-section-id="{{ section.id }}">
  <div class="qa-container">
    <div class="qa-head qa-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="qa-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="qa-h2" data-split>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.sub != blank -%}<p class="qa-lead" data-reveal style="--rd: 120">{{ section.settings.sub | escape }}</p>{%- endif -%}
    </div>

    <div class="qa-dash" data-dash data-thread-anchor="dashboard">
      <div class="qa-dash__chrome">
        <span class="qa-device__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="qa-dash__url">{{ section.settings.url_label | escape }}</span>
        <span class="qa-pill qa-pill--demo">{{ 'general.preview' | t }}</span>
      </div>
      <div class="qa-dash__app">
        <aside class="qa-dash__side" aria-hidden="true">
          <span class="qa-logo">{% render 'logo-mark' %}<span class="qa-logo__word">Quest<span> Agent</span></span></span>
          <span class="qa-dash__nav" data-dash-nav="overview">{% render 'icon', name: 'grid' %} Übersicht</span>
          <span class="qa-dash__nav">{% render 'icon', name: 'layers' %} Systeme</span>
          <span class="qa-dash__nav">{% render 'icon', name: 'film' %} Produktion</span>
          <span class="qa-dash__nav" data-dash-nav="review">{% render 'icon', name: 'inbox' %} Freigaben <i data-dash-badge>3</i></span>
          <span class="qa-dash__nav" data-dash-nav="calendar">{% render 'icon', name: 'calendar' %} Kalender</span>
          <span class="qa-dash__nav">{% render 'icon', name: 'plug' %} Verbindungen</span>
          <span class="qa-dash__nav">{% render 'icon', name: 'card' %} Abo</span>
        </aside>

        <div class="qa-dash__main">
          <div class="qa-dash__tabs" role="tablist" aria-label="{{ 'dashboard.tabs' | t }}">
            <button type="button" role="tab" id="{{ section.id }}-t-overview" aria-controls="{{ section.id }}-v-overview" aria-selected="true" data-dash-tab="overview">{{ 'dashboard.tab_overview' | t }}</button>
            <button type="button" role="tab" id="{{ section.id }}-t-review" aria-controls="{{ section.id }}-v-review" aria-selected="false" tabindex="-1" data-dash-tab="review">{{ 'dashboard.tab_review' | t }}</button>
            <button type="button" role="tab" id="{{ section.id }}-t-calendar" aria-controls="{{ section.id }}-v-calendar" aria-selected="false" tabindex="-1" data-dash-tab="calendar">{{ 'dashboard.tab_calendar' | t }}</button>
          </div>

          {%- comment -%} Übersicht {%- endcomment -%}
          <div class="qa-dash__view is-on" role="tabpanel" id="{{ section.id }}-v-overview" aria-labelledby="{{ section.id }}-t-overview" data-dash-view="overview">
            <h3 class="qa-dash__h">{{ section.settings.greeting | escape }}</h3>
            <div class="qa-kpis">
              <div class="qa-kpi"><small>Warten auf dich</small><b data-count="3">3</b></div>
              <div class="qa-kpi"><small>In Produktion</small><b data-count="2">2</b></div>
              <div class="qa-kpi"><small>Nächste Veröffentlichung</small><b style="font-size: 20px">Mi 18:00</b></div>
              <div class="qa-kpi"><small>Diesen Monat online</small><b data-count="17">17</b></div>
            </div>
            <div class="qa-dash__cols">
              <div class="qa-panel">
                <h4>Wartet auf deine Freigabe</h4>
                <div class="qa-item">
                  <span class="qa-thumb"><img src="{{ scene_space }}" alt="" loading="lazy" width="1600" height="900"></span>
                  <span class="qa-item__t"><b>Was, wenn es noch andere Welten gibt?</b><span>{% render 'platform-icon', platform: 'youtube' %} Video · Mi 18:00</span></span>
                  <span class="qa-mini-btn">Prüfen</span>
                </div>
                <div class="qa-item">
                  <span class="qa-thumb qa-thumb--v"><img src="{{ scene_space }}" alt="" loading="lazy" width="1600" height="900"></span>
                  <span class="qa-item__t"><b>Warum ist der Nachthimmel dunkel?</b><span>{% render 'platform-icon', platform: 'youtube' %}{% render 'platform-icon', platform: 'instagram' %}{% render 'platform-icon', platform: 'tiktok' %} Short · Do 12:00</span></span>
                  <span class="qa-mini-btn">Prüfen</span>
                </div>
                <div class="qa-item">
                  <span class="qa-thumb"><img src="{{ scene_history }}" alt="" loading="lazy" width="1600" height="900"></span>
                  <span class="qa-item__t"><b>Wie die Seidenstraße die Welt verband</b><span>{% render 'platform-icon', platform: 'youtube' %} Video · Do 19:00</span></span>
                  <span class="qa-mini-btn">Prüfen</span>
                </div>
              </div>
              <div class="qa-panel">
                <h4>Plan &amp; Kontingent</h4>
                <div class="qa-meter">Longform · 4 von 30<div class="qa-meter__bar"><span style="--w: 13%"></span></div></div>
                <div class="qa-meter">Shorts · 9 von 30<div class="qa-meter__bar"><span style="--w: 30%"></span></div></div>
                <h4 style="margin-top: 16px">Zuletzt online</h4>
                <div class="qa-item">
                  <span class="qa-thumb qa-thumb--v"><img src="{{ scene_ocean }}" alt="" loading="lazy" width="1600" height="900"></span>
                  <span class="qa-item__t"><b>Die leuchtenden Tiere der Tiefsee</b><span>{% render 'platform-icon', platform: 'youtube' %}{% render 'platform-icon', platform: 'instagram' %}{% render 'platform-icon', platform: 'tiktok' %} online</span></span>
                </div>
              </div>
            </div>
          </div>

          {%- comment -%} Freigabe {%- endcomment -%}
          <div class="qa-dash__view" role="tabpanel" id="{{ section.id }}-v-review" aria-labelledby="{{ section.id }}-t-review" data-dash-view="review" hidden>
            <h3 class="qa-dash__h">Prüfen &amp; freigeben</h3>
            <div class="qa-review">
              <div class="qa-review__video"><img src="{{ scene_space }}" alt="" loading="lazy" width="1600" height="900" style="object-position: 40% 50%"></div>
              <div style="display: grid; gap: 10px; align-content: start">
                <div class="qa-fieldmock"><small>Titel</small>Warum ist der Nachthimmel dunkel? #shorts</div>
                <div class="qa-fieldmock"><small>Beitragstext für Instagram &amp; TikTok</small>Eigentlich müsste der Himmel nachts hell sein …<br>#Astronomie #Weltall</div>
                <div class="qa-fieldmock"><small>Automatische Prüfung</small><span class="qa-pill qa-pill--ok">6 von 6 bestanden</span></div>
                <small class="qa-muted" style="font-weight: 700">Wird veröffentlicht auf</small>
                <div class="qa-chips">
                  <span class="qa-chip">{% render 'platform-icon', platform: 'youtube' %}</span>
                  <span class="qa-chip">{% render 'platform-icon', platform: 'instagram' %}</span>
                  <span class="qa-chip">{% render 'platform-icon', platform: 'tiktok' %}</span>
                  <span class="qa-chip">Do, 12:00</span>
                </div>
                <div class="qa-approve__btns" style="position: relative">
                  <span class="qa-btn qa-btn--sm">Überarbeiten</span>
                  <span class="qa-approve__ok" data-dash-approve style="--press: 1">{% render 'icon', name: 'check' %} Freigeben &amp; einplanen</span>
                  <span class="qa-cursor" data-dash-cursor style="right: 30%; bottom: -8px; opacity: 0">{% render 'icon', name: 'cursor' %}</span>
                </div>
              </div>
            </div>
          </div>

          {%- comment -%} Kalender {%- endcomment -%}
          <div class="qa-dash__view" role="tabpanel" id="{{ section.id }}-v-calendar" aria-labelledby="{{ section.id }}-t-calendar" data-dash-view="calendar" hidden>
            <h3 class="qa-dash__h">Kalender</h3>
            <div class="qa-week">
              <div class="qa-week__day">MO 28<div class="qa-evt" style="--c: var(--ok)">18:00 · Welten?<span class="qa-plats">{% render 'platform-icon', platform: 'youtube' %}</span></div></div>
              <div class="qa-week__day">DI 29<div class="qa-evt">12:00 · Schwarzes Loch<span class="qa-plats">{% render 'platform-icon', platform: 'youtube' %}{% render 'platform-icon', platform: 'instagram' %}{% render 'platform-icon', platform: 'tiktok' %}</span></div></div>
              <div class="qa-week__day is-today">MI 30<div class="qa-evt">18:00 · Welten?<span class="qa-plats">{% render 'platform-icon', platform: 'youtube' %}</span></div></div>
              <div class="qa-week__day" data-dash-newday>DO 1</div>
              <div class="qa-week__day">FR 2<div class="qa-evt" style="--c: var(--warn)">18:00 · Nachthimmel<span class="qa-plats">{% render 'platform-icon', platform: 'youtube' %}</span></div></div>
              <div class="qa-week__day">SA 3<div class="qa-evt">12:00 · Tiefsee<span class="qa-plats">{% render 'platform-icon', platform: 'youtube' %}{% render 'platform-icon', platform: 'instagram' %}</span></div></div>
              <div class="qa-week__day">SO 4</div>
            </div>
            <template data-dash-newevt>
              <div class="qa-evt is-new">12:00 · Nachthimmel<span class="qa-plats">{% render 'platform-icon', platform: 'youtube' %}{% render 'platform-icon', platform: 'instagram' %}{% render 'platform-icon', platform: 'tiktok' %}</span></div>
            </template>
          </div>

          <div class="qa-dash__toast" data-dash-toast role="status">{% render 'icon', name: 'check' %} Eingeplant für Do, 12:00 · 3 Plattformen</div>
        </div>
      </div>
    </div>
    {%- if section.settings.caption != blank -%}
      <p class="qa-dash__caption" data-reveal>{{ section.settings.caption | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dashboard-Vorschau",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Sprungmarke", "default": "dashboard" },
    { "type": "text", "id": "eyebrow", "label": "Oberzeile", "default": "Dein Dashboard" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Alles an einem Ort. Nichts ohne dein Okay." },
    { "type": "textarea", "id": "sub", "label": "Unterzeile", "default": "Freigaben, Kalender und Kontingent auf einen Blick – so sieht der Kundenbereich aus, den du nach dem Kauf nutzt." },
    { "type": "text", "id": "greeting", "label": "Begrüßung", "default": "Hallo! Dein Loop auf einen Blick" },
    { "type": "text", "id": "url_label", "label": "Adresszeile", "default": "Quest Agent – Kundenbereich" },
    { "type": "text", "id": "caption", "label": "Hinweis darunter", "default": "Vorschau mit Beispieldaten. Tabs anklicken zum Ausprobieren." }
  ],
  "presets": [{ "name": "Dashboard-Vorschau" }]
}
{% endschema %}
