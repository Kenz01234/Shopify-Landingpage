<section class="qa-hero qa-intro" style="min-height: 100svh; display: grid; align-items: center">
  <div class="qa-hero__glow" aria-hidden="true"></div>
  <div class="qa-hero__grid" aria-hidden="true"></div>
  <div class="qa-container qa-container--narrow">
    <p data-intro style="--d: 0; display: flex; justify-content: center; margin-bottom: 28px">
      <span class="qa-logo">{% render 'logo-mark' %}<span class="qa-logo__word">{{ shop.name | escape }}</span></span>
    </p>
    <h1 class="qa-h1"><span data-words>{{ section.settings.heading | escape }}</span></h1>
    {%- if shop.password_message != blank -%}
      <p class="qa-lead qa-hero__sub" data-intro style="--d: 500">{{ shop.password_message | escape }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'qa-search-form', style: 'margin: 36px auto 0' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, warteliste">
      {%- if form.posted_successfully? -%}
        <p class="qa-pill qa-pill--ok" role="status">{{ 'password.subscribed' | t }}</p>
      {%- else -%}
        <label class="qa-visually-hidden" for="qa-pw-mail">{{ 'contact.email' | t }}</label>
        <input class="qa-input" id="qa-pw-mail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'password.email_placeholder' | t }}">
        <button class="qa-btn qa-btn--primary" type="submit">{{ 'password.notify' | t }}</button>
      {%- endif -%}
    {%- endform -%}

    <details style="margin-top: 36px">
      <summary class="qa-btn qa-btn--ghost qa-btn--sm" style="list-style: none">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'qa-search-form', style: 'margin: 16px auto 0' -%}
        {%- if form.errors -%}<p class="qa-note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="qa-visually-hidden" for="qa-pw">{{ 'password.password' | t }}</label>
        <input class="qa-input" id="qa-pw" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
        <button class="qa-btn qa-btn--dark" type="submit">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Passwortseite",
  "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Bald geht’s los." }]
}
{% endschema %}
