{%- liquid
  assign scene_file = 'qa-scene-' | append: section.settings.scene | append: '.svg'
-%}
<section class="qa-hero qa-intro" id="start" data-qa-hero data-section-id="{{ section.id }}">
  <div class="qa-hero__glow" aria-hidden="true"></div>
  <div class="qa-hero__grid" aria-hidden="true"></div>
  <div class="qa-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="qa-hero__eyebrow" data-intro style="--d: 0">
        <span class="qa-pill qa-pill--coral"><span class="qa-dot qa-dot--pulse" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</span>
      </p>
    {%- endif -%}
    <h1 class="qa-h1 qa-hero__title" data-thread-anchor="hero">
      <span class="qa-hero__line" data-words>{{ section.settings.line1 | escape }}</span>
      <span class="qa-hero__line">
        <span class="qa-accent" data-words>{{ section.settings.line2 | escape }}</span>
        <span class="qa-serif qa-accent" data-words>{{ section.settings.accent | escape }}</span>
      </span>
    </h1>
    {%- if section.settings.sub != blank -%}
      <p class="qa-lead qa-hero__sub" data-intro style="--d: 360">{{ section.settings.sub | escape }}</p>
    {%- endif -%}
    <div class="qa-hero__ctas" data-intro style="--d: 460">
      {%- if section.settings.cta1_label != blank -%}
        <a class="qa-btn qa-btn--primary qa-btn--lg" href="{% render 'nav-href', link: section.settings.cta1_link %}" data-magnetic>
          {{- section.settings.cta1_label | escape }} {% render 'icon', name: 'arrow-right', class: 'qa-btn__arrow' %}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="qa-btn qa-btn--lg" href="{% render 'nav-href', link: section.settings.cta2_link %}">
          <span class="qa-plat" style="background: var(--ink); color: var(--bg)">{% render 'icon', name: 'play' %}</span>
          {{- section.settings.cta2_label | escape -}}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="qa-hero__note" data-intro style="--d: 560">{{ section.settings.note | escape }}</p>
    {%- endif -%}

    {%- comment -%}
      Beispiel-Ablauf, der beim Öffnen sofort startet und sich wiederholt: Recherche → Skript → Stimme → Schnitt →
      Prüfung → Freigabe → Upload → danach zählen Beispiel-Statistiken hoch. Alle Werte sind als Beispiel markiert.
    {%- endcomment -%}
    <div class="qa-hero__stage" data-intro style="--d: 480" data-hero-stage data-phase="research" aria-label="{{ 'hero.stage_label' | t }}" role="img">
      <div class="qa-pill qa-hero__status">
        <span class="qa-dot qa-dot--pulse" aria-hidden="true"></span>
        <span data-qa-status data-labels="{{ 'hero.phase_labels' | t | escape }}">{{ 'hero.status_default' | t }}</span>
      </div>
      <div class="qa-hero__video">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700, 1000, 1400', sizes: '(min-width: 750px) 640px, 88vw', alt: '' }}
        {%- else -%}
          <img src="{{ scene_file | asset_url }}" alt="" width="1600" height="900" fetchpriority="high">
        {%- endif -%}
        <div class="qa-hero__scan" aria-hidden="true"></div>
        {%- if section.settings.video_title != blank -%}
          <div class="qa-preview__title">{{ section.settings.video_title | escape }}</div>
        {%- endif -%}
        <div class="qa-hero__layer qa-hero__layer--script" aria-hidden="true">
          <span style="--i: 0">{{ 'hero.script_1' | t }}</span>
          <span style="--i: 1">{{ 'hero.script_2' | t }}</span>
        </div>
        <div class="qa-hero__layer qa-hero__layer--voice" aria-hidden="true">
          {%- for i in (0..23) -%}
            {%- assign h = i | times: 37 | modulo: 61 | plus: 25 -%}
            <i style="--i: {{ i }}; --h: {{ h }}"></i>
          {%- endfor -%}
        </div>
        <div class="qa-hero__layer qa-hero__layer--edit" aria-hidden="true">
          <span style="--w: 3; --i: 0"></span><span style="--w: 2; --i: 1"></span><span style="--w: 4; --i: 2; --c: var(--violet)"></span><span style="--w: 2; --i: 3; --c: var(--ok)"></span>
        </div>
        <div class="qa-hero__layer qa-hero__layer--check" aria-hidden="true">
          <span>{% render 'icon', name: 'check' %} 7:12 min</span>
          <span>{% render 'icon', name: 'check' %} {{ 'hero.check_audio' | t }}</span>
          <span>{% render 'icon', name: 'check' %} {{ 'hero.check_rights' | t }}</span>
        </div>
        <div class="qa-hero__video-ui">
          {%- render 'icon', name: 'play' -%}
          <div class="qa-hero__video-bar"><span></span></div>
          <span>{{ 'hero.example' | t }}</span>
        </div>
      </div>

      <ol class="qa-hero__phases" aria-hidden="true">
        {%- assign phases = 'hero.phases' | t | split: '|' -%}
        {%- for ph in phases -%}
          <li style="--i: {{ forloop.index0 }}">{{ ph }}</li>
        {%- endfor -%}
      </ol>

      <div class="qa-float qa-float--yt" style="--d: 0" data-parallax="-0.08">
        {% render 'platform-icon', platform: 'youtube', size: 'lg' %}
        <span>
          YouTube
          <small class="qa-when-planned">{{ 'hero.float_video' | t }}</small>
          <small class="qa-when-live"><b data-hero-count="18400">0</b> {{ 'hero.views' | t }}</small>
        </span>
      </div>
      <div class="qa-float qa-float--ig" style="--d: 150" data-parallax="-0.14">
        {% render 'platform-icon', platform: 'instagram', size: 'lg' %}
        <span>
          Instagram Reels
          <small class="qa-when-planned">{{ 'hero.float_short' | t }}</small>
          <small class="qa-when-live"><b data-hero-count="9700">0</b> {{ 'hero.views' | t }}</small>
        </span>
      </div>
      <div class="qa-float qa-float--tt" style="--d: 300" data-parallax="-0.05">
        {% render 'platform-icon', platform: 'tiktok', size: 'lg' %}
        <span>
          TikTok
          <small class="qa-when-planned">{{ 'hero.float_short' | t }}</small>
          <small class="qa-when-live"><b data-hero-count="20100">0</b> {{ 'hero.views' | t }}</small>
        </span>
      </div>
      <div class="qa-float qa-float--ok" style="--d: 450" data-parallax="-0.11">
        <span class="qa-plat qa-plat--lg" style="background: var(--ok)">{% render 'icon', name: 'check' %}</span>
        <span>{{ 'hero.float_ok' | t }}<small>{{ 'hero.float_ok_sub' | t }}</small></span>
      </div>

      <div class="qa-hero__stats" data-parallax="-0.06">
        <div class="qa-hero__stats-head">
          {%- render 'icon', name: 'trend' -%}
          <b>{{ 'hero.stats_title' | t }}</b>
          <span class="qa-pill qa-pill--demo">{{ 'hero.example' | t }}</span>
        </div>
        <div class="qa-hero__kpis">
          <div><small>{{ 'hero.kpi_views' | t }}</small><b><span data-hero-count="48200">0</span></b></div>
          <div><small>{{ 'hero.kpi_watch' | t }}</small><b><span data-hero-count="1930">0</span> h</b></div>
          <div><small>{{ 'hero.kpi_subs' | t }}</small><b>+<span data-hero-count="612">0</span></b></div>
          <div><small>{{ 'hero.kpi_ctr' | t }}</small><b><span data-hero-count="68" data-decimals="1">0</span> %</b></div>
        </div>
        <svg class="qa-hero__spark" viewBox="0 0 240 56" aria-hidden="true">
          <path class="qa-hero__spark-fill" d="M0 52 L20 48 L40 50 L60 42 L80 44 L100 34 L120 36 L140 26 L160 28 L180 18 L200 20 L220 10 L240 6 L240 56 L0 56 Z"/>
          <path class="qa-hero__spark-line" pathLength="1" d="M0 52 L20 48 L40 50 L60 42 L80 44 L100 34 L120 36 L140 26 L160 28 L180 18 L200 20 L220 10 L240 6"/>
        </svg>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero (Intro)",
  "tag": "div",
  "class": "qa-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Oberzeile", "default": "YouTube-Automation. Ohne Kamera. Ohne Einsprechen." },
    { "type": "text", "id": "line1", "label": "Überschrift, Zeile 1", "default": "Dein Faceless-Kanal." },
    { "type": "text", "id": "line2", "label": "Überschrift, Zeile 2 (fett)", "default": "Läuft" },
    { "type": "text", "id": "accent", "label": "Überschrift, Zeile 2 (kursiv)", "default": "für dich." },
    { "type": "textarea", "id": "sub", "label": "Unterzeile", "default": "Nische und Vorbilder wählen. Uploadplan festlegen. Prüfen, freigeben, fertig – auf YouTube, Instagram und TikTok." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta1_label", "label": "Haupt-Button", "default": "Eigenes System erstellen" },
    { "type": "text", "id": "cta1_link", "label": "Haupt-Button – Ziel", "default": "#preise", "info": "Sprungmarke (#preise) oder Adresse (/products/…)" },
    { "type": "text", "id": "cta2_label", "label": "Zweiter Button", "default": "Den Loop entdecken" },
    { "type": "text", "id": "cta2_link", "label": "Zweiter Button – Ziel", "default": "#loop" },
    { "type": "text", "id": "note", "label": "Hinweis unter den Buttons", "default": "Keine Erfolgsgarantie – aber deutlich weniger Routine." },
    { "type": "header", "content": "Beispielvideo" },
    {
      "type": "select",
      "id": "scene",
      "label": "Motiv",
      "options": [
        { "value": "space", "label": "Weltall" },
        { "value": "history", "label": "Geschichte" },
        { "value": "ocean", "label": "Tiefsee" },
        { "value": "nature", "label": "Natur" },
        { "value": "tech", "label": "Technik" }
      ],
      "default": "space"
    },
    { "type": "image_picker", "id": "image", "label": "Eigenes Bild (ersetzt das Motiv)" },
    { "type": "text", "id": "video_title", "label": "Titel im Video", "default": "Was, wenn es noch andere Welten gibt?" }
  ],
  "presets": [{ "name": "Hero (Intro)" }]
}
{% endschema %}
