<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js" data-theme-default="{{ settings.color_mode_default | default: 'system' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <script>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var pref = d.getAttribute('data-theme-default') || 'system';
        try { pref = localStorage.getItem('qa-theme') || pref; } catch (e) {}
        var dark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        d.setAttribute('data-theme', dark ? 'dark' : 'light');
        d.setAttribute('data-theme-pref', pref);
      })();
    </script>
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    <style>
      @font-face { font-family: "QA Inter Tight"; src: url("{{ 'qa-inter-tight.woff2' | asset_url }}") format("woff2"); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: "QA Instrument Serif"; src: url("{{ 'qa-instrument-serif-italic.woff2' | asset_url }}") format("woff2"); font-style: italic; font-display: swap; }
    </style>
    {{ 'qa-theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'qa-theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="qa-body template-password">
    <main id="MainContent" class="qa-main">{{ content_for_layout }}</main>
  </body>
</html>
