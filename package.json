{
  "name": "quest-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Quest Agent – Faceless-YouTube-System mit menschlicher Freigabe (Website, Kundenbereich, Backend, Worker).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
