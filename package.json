    "test": "vitest run",
    "test:e2e": "playwright test",
    "shopify:zip": "node scripts/build-shopify-zip.mjs",
    "shopify:check": "node scripts/check-shopify.mjs",
    "shopify:theme": "node scripts/build-shopify-horizon-theme.mjs",
    "project:zip": "node scripts/build-project-zip.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.6",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
