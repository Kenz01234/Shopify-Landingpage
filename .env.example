# ---------------------------------------------------------------------------
# Quest Agent – Beispielkonfiguration. Kopieren nach .env und anpassen.
# Enthält KEINE echten Schlüssel. Niemals echte Geheimnisse committen.
# ---------------------------------------------------------------------------

# --- Basis -------------------------------------------------------------------
# PostgreSQL-Verbindung (lokal oder Docker: postgresql://quest:quest@db:5432/quest_agent)
DATABASE_URL=postgresql://quest:quest@localhost:5432/quest_agent
# Öffentliche Adresse der App (für Links, OAuth-Callbacks, Webhooks)
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Mindestens 32 zufällige Zeichen, z. B.: openssl rand -base64 48
BETTER_AUTH_SECRET=bitte-durch-ein-langes-zufaelliges-geheimnis-ersetzen
# 32 Byte Base64 für AES-256-GCM (kundenindividuelle Tokens, z. B. YouTube): openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
NEXT_TELEMETRY_DISABLED=1

# --- Demo-Modus ----------------------------------------------------------------
# true = lokale Demo-Konten, simulierte Provider, Demo-Zeitsteuerung. Im echten Betrieb: false.
DEMO_MODE=true
# Passwort der lokalen Demo-Konten (Seed). Nur lokal verwenden.
DEMO_PASSWORD=QuestDemo-2026!
# Erlaubt DEMO_MODE bei `next start` (NODE_ENV=production) für die LOKALE Vorschau.
ALLOW_DEMO_IN_PRODUCTION=true
# Tempo der simulierten Produktion (ms pro Schritt) und Worker-Takte
DEMO_STEP_MS=2500
WORKER_TICK_MS=1000
SCHEDULER_TICK_MS=5000
# Wie viele Tage im Voraus Aufträge für kommende Slots angelegt werden
PLANNING_HORIZON_DAYS=7

# --- Provider-Auswahl ------------------------------------------------------------
# demo | n8n
PRODUCTION_PROVIDER=demo
# demo | elevenlabs
VOICE_PROVIDER=demo
# demo | youtube   (youtube lädt ECHT hoch – nur mit ausdrücklich freigegebenem Live-Test)
PUBLISH_PROVIDER=demo
# demo | stripe
BILLING_PROVIDER=demo

# --- n8n (Betreiber-Verbindung, Vertrag siehe docs/INTEGRATIONEN.md) -------------
# Webhook-URL des n8n-Workflows, der Aufträge annimmt (keine Workflow-ID erfinden)
N8N_JOB_WEBHOOK_URL=
# Gemeinsames Geheimnis für HMAC-Signaturen in beide Richtungen (mind. 32 Zeichen)
N8N_SHARED_SECRET=
# Minuten ohne Rückmeldung, bis ein extern laufender Auftrag als fehlgeschlagen gilt
N8N_EXTERNAL_TIMEOUT_MIN=240
# Hosts, von denen Medien aus n8n-Ergebnissen geladen werden dürfen (kommagetrennt, nur https)
ASSET_DOWNLOAD_ALLOWED_HOSTS=
ASSET_DOWNLOAD_MAX_MB=1024

# --- ElevenLabs (Betreiber-Verbindung, Schlüssel nur serverseitig) ----------------
ELEVENLABS_API_KEY=
# Modell-ID laut ElevenLabs-Konto/Dokumentation (nicht raten)
ELEVENLABS_MODEL_ID=
# Optional: erlaubte Voice-IDs (kommagetrennt) – nur echte IDs aus /v2/voices
ELEVENLABS_VOICE_IDS=

# --- YouTube (Google OAuth, pro Kunde) -------------------------------------------
# Redirect-URI in der Google Cloud Console: {APP_URL}/api/connections/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram (Reels, pro Kunde über Instagram-Login) -----------------------------
# demo | instagram   (instagram veröffentlicht ECHT – nur mit ausdrücklich freigegebenem Live-Test)
INSTAGRAM_PROVIDER=demo
# Meta-App (Instagram-Login); Redirect-URI: {APP_URL}/api/connections/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Graph-API-Version laut aktueller Meta-Doku
INSTAGRAM_GRAPH_VERSION=v23.0

# --- TikTok (Content Posting API, pro Kunde über TikTok-Login) ---------------------
# demo | tiktok      (tiktok veröffentlicht ECHT – nur mit ausdrücklich freigegebenem Live-Test)
TIKTOK_PROVIDER=demo
# Redirect-URI: {APP_URL}/api/connections/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Ungeprüfte TikTok-Apps dürfen nur privat veröffentlichen
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Shopify als Verkaufsweg (Webhook orders/paid schaltet den Plan frei) ---------
# z. B. dein-shop.myshopify.com (keine Domain erfinden – steht im Shopify-Admin)
SHOPIFY_SHOP_DOMAIN=
# Signaturschlüssel aus Einstellungen → Benachrichtigungen → Webhooks
SHOPIFY_WEBHOOK_SECRET=
# Kommagetrennte SKUs oder Varianten-IDs der Plan-Produkte
SHOPIFY_PLAN_STARTER=
SHOPIFY_PLAN_STUDIO=

# --- Stripe (nur Testmodus; Live-Schlüssel sind ohne ALLOW_STRIPE_LIVE=true gesperrt) --
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
